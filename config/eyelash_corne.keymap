#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };


#define BASE 0
#define EXT 1
#define SYM 2
#define NUM 3
#define GAME 4
#define GAME_NUM 5

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_escape {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <2 3>;
            layers = <BASE>;
            bindings = <&kp ESC>;
        };
        combo_backspace {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <9 10>;
            layers = <BASE>;
            bindings = <&kp BSPC>;
        };
        combo_tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <30 31>;
            layers = <BASE>;
            bindings = <&kp TAB>;
        };
        combo_enter {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <38 39>;
            layers = <BASE>;
            bindings = <&kp ENTER>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &mmv MOVE_UP  &kp Y  &kp U  &kp I  &kp O  &kp P  &mo NUM
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &mo SYM  &mmv MOVE_DOWN  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp BSPC  &mo EXT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        ext_layer {
            display-name = "EXT";
            bindings = <
                &kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &mo NUM
                &kp TAB  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL  &mmv MOVE_LEFT  &mkp RCLK  &mmv MOVE_RIGHT  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LSHFT  &kp F11  &kp F12  &kp C  &kp V  &kp B  &mo SYM  &mmv MOVE_DOWN  &kp N  &kp M  &kp COMMA  &kp DOT  &kp DEL  &to GAME
                &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp BSPC  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp ESC  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &mmv MOVE_UP  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &mo NUM
                &kp TAB  &kp GRAVE  &kp TILDE  &kp LBKT  &kp RBKT  &kp BSLH  &mmv MOVE_LEFT  &mkp MCLK  &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp PIPE  &kp DQT
                &kp LSHFT  &kp LT  &kp GT  &kp LPAR  &kp RPAR  &kp UNDER  &trans  &mmv MOVE_DOWN  &kp PLUS  &kp EQUAL  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp BSPC  &mo EXT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        num_layer {
            display-name = "NUM";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &mmv MOVE_UP  &kp FSLH  &kp N7  &kp N8  &kp N9  &kp ASTRK  &trans
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &out OUT_USB  &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp PLUS  &kp N4  &kp N5  &kp N6  &kp MINUS  &out OUT_BLE
                &kp LSHFT  &studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &mo SYM  &mmv MOVE_DOWN  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT  &soft_off
                &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp BSPC  &mo EXT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        game_layer {
            display-name = "GAME";
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &mmv MOVE_UP  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp N7  &kp N8  &kp N9  &kp N0  &kp LCTRL  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp SPACE  &mmv MOVE_DOWN  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &to BASE
                &kp LALT  &mo GAME_NUM  &kp SPACE  &kp BSPC  &kp RSHFT  &kp ENTER
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        game_num_layer {
            display-name = "GAME NUM";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &mmv MOVE_UP  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6
                &kp TAB  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp N7  &kp N8  &kp N9  &kp N0  &kp LCTRL  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp SPACE  &mmv MOVE_DOWN  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &to BASE
                &kp LALT  &mo GAME_NUM  &kp SPACE  &kp BSPC  &kp RSHFT  &kp ENTER
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
